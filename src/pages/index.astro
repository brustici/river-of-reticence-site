---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import cover from '../assets/cover.jpg';
import {
  book, directSale, retailers, formats, excerpt, reviews, authorInfo, newsletter, lovedTheBook,
} from '../data/site';

const noteForm = lovedTheBook.noteForm;
import { homeJsonLd } from '../data/seo';

const title = `${book.title}: ${book.subtitle} by ${book.author}`;
const description = 'A dual-perspective suspense novel set in 1960s–80s small-town Vermont, about friendship, survival and the secrets we never say. Available now in paperback and hardcover.';
---

<Base title={title} description={description} ogType="book" jsonLd={homeJsonLd}>
  <section class="hero">
    <div class="hero-cover">
      <Image src={cover} alt={`Cover of ${book.title} by ${book.author}: a sepia pencil drawing of a long-haired girl sitting on a fallen log beside a wooded river, a backpack at her feet.`} widths={[360, 540, 720]} sizes="(max-width: 760px) 70vw, 360px" loading="eager" />
    </div>
    <div class="hero-text">
      <p class="eyebrow">{book.subtitle}</p>
      <h1>{book.title}</h1>
      <p class="byline">{book.author}</p>
      <p class="tagline">{book.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#buy">Buy now</a>
        <a class="btn btn-ghost" href="#excerpt">Read the prologue</a>
      </div>
    </div>
  </section>

  <div class="rule" aria-hidden="true"><span>❦</span></div>

  <section id="about" class="section prose-section">
    <h2>About the Book</h2>
    <p class="meta">{book.genre} · {book.setting}</p>
    {book.blurb.map((p, i) => <p class={i === 0 ? 'lede' : undefined}>{p}</p>)}
    {book.contentNote && <p class="content-note">Content note: {book.contentNote}</p>}
  </section>

  <section id="excerpt" class="section excerpt">
    <div class="excerpt-card">
      <p class="eyebrow">Excerpt</p>
      <h2>{excerpt.heading}</h2>
      <p class="place">{excerpt.place}</p>
      {excerpt.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {reviews.length > 0 && (
    <section id="praise" class="section praise">
      <h2>Praise</h2>
      <div class="quotes">
        {reviews.map((r) => (
          <figure>
            <blockquote>“{r.quote}”</blockquote>
            <figcaption>{r.source}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section id="buy" class="section buy">
    <h2>Buy the Book</h2>
    <p class="meta">Available now in {formats.join(' and ').toLowerCase()}</p>
    <h3 class="buy-heading">{directSale.heading}</h3>
    <ul class="retailers">
      {directSale.links.map((l) => (
        <li>
          <a class="btn btn-accent" href={l.url} data-store={l.id} target="_blank" rel="noopener">{l.label}</a>
        </li>
      ))}
    </ul>
    <h3 class="buy-heading">{directSale.retailersHeading}</h3>
    <ul class="retailers">
      {retailers.map((r) => (
        <li>
          <a class="btn btn-primary" href={r.url} data-store={r.id} target="_blank" rel="noopener">{retailers.length === 1 ? `Buy on ${r.name}` : r.name}</a>
        </li>
      ))}
    </ul>
    <dl class="details">
      {book.details.map((d) => (<div><dt>{d.label}</dt><dd>{d.value}</dd></div>))}
    </dl>
  </section>

  {(lovedTheBook.reviewLinks.length > 0 || noteForm) && (
    <section id="loved" class="section loved">
      <div class="loved-inner">
        <h2>{lovedTheBook.heading}</h2>
        <p class="loved-intro">{lovedTheBook.intro}</p>
        {lovedTheBook.reviewLinks.length > 0 && (
          <>
            <h3 class="buy-heading">{lovedTheBook.reviewHeading}</h3>
            <ul class="retailers">
              {lovedTheBook.reviewLinks.map((l) => (
                <li><a class="btn btn-ghost" href={l.url} data-review={l.id} target="_blank" rel="noopener">{l.name}</a></li>
              ))}
            </ul>
          </>
        )}
        {noteForm && (
          <>
            <h3 class="buy-heading">{lovedTheBook.noteHeading}</h3>
            <p class="loved-intro">{lovedTheBook.noteIntro}</p>
            <form class="note-form" id="note-form" action={noteForm.action} method="POST">
              <div class="note-row">
                <label><span>Your name</span> <input type="text" name={noteForm.fields.name} autocomplete="given-name" required /></label>
                <label><span>Town <span class="optional">(optional)</span></span> <input type="text" name={noteForm.fields.town} autocomplete="address-level2" placeholder="e.g. Marquette, MI" /></label>
              </div>
              <label><span>Email <span class="optional">(optional, so Geri can write back)</span></span> <input type="email" name={noteForm.fields.email} autocomplete="email" /></label>
              <label><span>Your note</span> <textarea name={noteForm.fields.note} rows="6" required></textarea></label>
              <label class="note-check"><input type="checkbox" name={noteForm.fields.okToQuote} value={noteForm.okToQuoteValue} /> It’s OK to quote my note on this website, with my first name and town.</label>
              <div class="note-trap" aria-hidden="true"><label>Leave this empty <input type="text" id="note-trap" tabindex="-1" autocomplete="off" /></label></div>
              <button class="btn btn-primary" type="submit">Send</button>
              <p class="note-status" id="note-status" role="status"></p>
            </form>
          </>
        )}
      </div>
    </section>
  )}

  <section id="author" class="section prose-section author">
    <h2>About the Author</h2>
    <p>{authorInfo.teaser}</p>
    <p><a class="btn btn-ghost" href="/about/" aria-label="Read more about Geri Miller">Read more</a></p>
  </section>

  {newsletter.url && (
    <section id="newsletter" class="section newsletter">
      <h2>Stay in Touch</h2>
      <p>{newsletter.blurb}</p>
      <a class="btn btn-primary" href={newsletter.url} target="_blank" rel="noopener">Join the newsletter</a>
    </section>
  )}
</Base>

<script>
  // Post the note to the Google Form in the background so the reader stays on
  // the page. Google's endpoint sends no CORS headers, so the response is opaque:
  // only a network failure is detectable. Without JS the form posts normally.
  const form = document.getElementById('note-form') as HTMLFormElement | null;
  const status = document.getElementById('note-status');
  const trap = document.getElementById('note-trap') as HTMLInputElement | null;
  const thank = () => {
    const p = document.createElement('p');
    p.className = 'note-thanks';
    p.textContent = 'Thank you! Your note is on its way to Geri.';
    form!.replaceWith(p);
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (trap?.value) return thank(); // bots fill the hidden field
    const button = form.querySelector('button')!;
    button.disabled = true;
    if (status) status.textContent = 'Sending…';
    try {
      await fetch(form.action, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
      });
      (window as any).gtag?.('event', 'note_submit');
      thank();
    } catch {
      button.disabled = false;
      if (status) status.textContent = 'Sorry, that didn’t send. Please check your connection and try again.';
    }
  });
</script>
